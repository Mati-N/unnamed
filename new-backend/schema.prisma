// This file is automatically generated by Keystone, do not modify it manually.
// Modify your Keystone config when you want to change this.

datasource sqlite {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String         @id @default(cuid())
  username           String         @unique @default("")
  email              String         @unique @default("")
  password           String
  bio                String         @default("")
  profile_image      String?
  date_joined        DateTime?      @default(now())
  posts              Post[]         @relation("Post_user")
  comments           Comment[]      @relation("Comment_user")
  likes              Like[]         @relation("Like_user")
  notifications      Notification[] @relation("Notification_recipient")
  sent_notifications Notification[] @relation("Notification_sender")
  following          Following[]    @relation("Following_follower")
  followers          Following[]    @relation("Following_target")
  from_Page_author   Page[]         @relation("Page_author")
}

model Post {
  id            String         @id @default(cuid())
  title         String         @default("")
  text          String         @default("")
  createdAt     DateTime?      @default(now())
  updatedAt     DateTime?      @updatedAt
  user          User?          @relation("Post_user", fields: [userId], references: [id])
  userId        String?        @map("user")
  likeCount     Int?           @default(0)
  comments      Comment[]      @relation("Comment_post")
  likes         Like[]         @relation("Like_post")
  notifications Notification[] @relation("Notification_post")

  @@index([userId])
}

model Comment {
  id            String         @id @default(cuid())
  content       String         @default("")
  createdAt     DateTime?      @default(now())
  updatedAt     DateTime?      @updatedAt
  user          User?          @relation("Comment_user", fields: [userId], references: [id])
  userId        String?        @map("user")
  post          Post?          @relation("Comment_post", fields: [postId], references: [id])
  postId        String?        @map("post")
  notifications Notification[] @relation("Notification_comment")

  @@index([userId])
  @@index([postId])
}

model Like {
  id     String  @id @default(cuid())
  user   User?   @relation("Like_user", fields: [userId], references: [id])
  userId String? @map("user")
  post   Post?   @relation("Like_post", fields: [postId], references: [id])
  postId String? @map("post")

  @@index([userId])
  @@index([postId])
}

model Following {
  id         String  @id @default(cuid())
  target     User?   @relation("Following_target", fields: [targetId], references: [id])
  targetId   String? @map("target")
  follower   User?   @relation("Following_follower", fields: [followerId], references: [id])
  followerId String? @map("follower")

  @@index([targetId])
  @@index([followerId])
}

model Notification {
  id          String    @id @default(cuid())
  category    String    @default("")
  read        Boolean   @default(false)
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
  recipient   User?     @relation("Notification_recipient", fields: [recipientId], references: [id])
  recipientId String?   @map("recipient")
  sender      User?     @relation("Notification_sender", fields: [senderId], references: [id])
  senderId    String?   @map("sender")
  post        Post?     @relation("Notification_post", fields: [postId], references: [id])
  postId      String?   @map("post")
  comment     Comment?  @relation("Notification_comment", fields: [commentId], references: [id])
  commentId   String?   @map("comment")

  @@index([recipientId])
  @@index([senderId])
  @@index([postId])
  @@index([commentId])
}

model Page {
  id              String    @id @default(cuid())
  title           String    @default("")
  slug            String    @unique @default("")
  content         String    @default("[{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]}]")
  author          User?     @relation("Page_author", fields: [authorId], references: [id])
  authorId        String?   @map("author")
  publishedAt     DateTime?
  metaTitle       String    @default("")
  metaDescription String    @default("")

  @@index([authorId])
}
